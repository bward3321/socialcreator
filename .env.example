# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Pulsr <hello@yourdomain.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxx

# Zernio (social media API)
ZERNIO_API_KEY=sk_xxxxxxxxxxxx

# Cron secret (any random string, used to protect cron endpoints)
CRON_SECRET=your-random-secret-here

# Auth
AUTH_SECRET=a-random-32-char-string-for-hashing
